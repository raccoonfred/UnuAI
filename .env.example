# Copy this file to .env.local and fill in what you need.

# Required for every AI feature. Get a key at https://platform.claude.com
ANTHROPIC_API_KEY=

# Protects the app with a password. Set this before putting the app online.
APP_PASSWORD=

# Optional: models and time zone (defaults shown). The defaults are chosen to keep costs low:
# the cheap model handles quick writing and voice, the standard one handles chat, research and pages.
# Set either to claude-opus-5-5 for top quality at a higher price.
# UNUAI_MODEL_QUICK=claude-haiku-5-5
# UNUAI_MODEL_STANDARD=claude-sonnet-5-5
# UNUAI_TIMEZONE=Europe/Bucharest
# UNUAI_DB_PATH=./data/unuai.db

# Optional: phone calls through Twilio (https://www.twilio.com)
# PUBLIC_BASE_URL is the public https address of this app, used for Twilio webhooks.
# Your own phone number goes in Brand brain > "Your phone", or OWNER_PHONE.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
PUBLIC_BASE_URL=
# OWNER_PHONE=+40...
# Call language follows the app language (RO/EN switch) unless set here:
# PHONE_LANGUAGE=ro-RO
# PHONE_VOICE=Google.ro-RO-Wavenet-A

# Optional: natural voices (ElevenLabs) for "read aloud" and phone calls, one voice per language.
# Free account at https://elevenlabs.io > Profile > API keys. Pick the voices in Brand brain > Voices.
# Without it, the browser's own voice (chat) and Twilio's voice (calls) are used.
ELEVENLABS_API_KEY=
# ELEVENLABS_MODEL=eleven_flash_v2_5
# ELEVENLABS_VOICE_RO=
# ELEVENLABS_VOICE_EN=
